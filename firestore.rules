rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 物件資料開放給所有登入過的員工帳號讀取/新增/編輯，刪除只限本人
    match /properties/{propId} {
      allow read, create, update: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == "KiYlsnWcChW5muRkG167r7Mi1132";

      match /priceLogs/{docId} {
        allow read, write: if request.auth != null;
      }
      match /statusLogs/{docId} {
        allow read, write: if request.auth != null;
      }
      // 市場資料只允許已登入員工讀取；寫入必須經過驗證 Firebase token 的後端 API。
      match /marketListings/{docId} {
        allow read: if request.auth != null;
        allow write: if false;
      }
      match /marketPhotos/{docId} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }

    // 同事異動紀錄：任何登入帳號都能新增一筆，但只有你能讀取（同事看不到彼此的紀錄，避免互相對照有壓力）
    match /propertyActivityLog/{logId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && request.auth.uid == "KiYlsnWcChW5muRkG167r7Mi1132";
    }

    // 同事名冊：任何登入帳號都能讀（分享對象選單要用到），只有自己能寫自己的名字
    match /colleagues/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // 每個帳號自己的個人設定（例如自己的 agid），只有自己能讀寫
    match /userSettings/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // 買方／賣方聯絡人：擁有者、被分享的同事、或你（主要負責人）都能讀寫
    match /contacts/{contactId} {
      allow read: if request.auth != null && (
        request.auth.uid == "KiYlsnWcChW5muRkG167r7Mi1132" ||
        resource.data.ownerUid == request.auth.uid ||
        (request.auth.uid in resource.data.sharedWith)
      );
      allow update: if request.auth != null &&
        request.resource.data.ownerUid == resource.data.ownerUid &&
        (
          request.auth.uid == "KiYlsnWcChW5muRkG167r7Mi1132" ||
          resource.data.ownerUid == request.auth.uid ||
          (
            (request.auth.uid in resource.data.sharedWith) &&
            request.resource.data.sharedWith == resource.data.sharedWith
          )
        );
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if request.auth != null && (resource.data.ownerUid == request.auth.uid || request.auth.uid == "KiYlsnWcChW5muRkG167r7Mi1132");

      match /listings/{listingId} {
        allow read, update: if isOwnerOrShared(get(/databases/$(database)/documents/contacts/$(contactId)).data);
        allow create: if isOwnerOrShared(get(/databases/$(database)/documents/contacts/$(contactId)).data);
        allow delete: if request.auth != null && (
          get(/databases/$(database)/documents/contacts/$(contactId)).data.ownerUid == request.auth.uid ||
          request.auth.uid == "KiYlsnWcChW5muRkG167r7Mi1132"
        );
        match /{subcollection}/{docId} {
          allow read, write: if isOwnerOrShared(get(/databases/$(database)/documents/contacts/$(contactId)/listings/$(listingId)).data);
        }
      }
      match /appointments/{appointmentId} {
        allow create: if isOwnerOrShared(getAfter(/databases/$(database)/documents/contacts/$(contactId)).data);
      }
      match /{subcollection}/{docId} {
        allow read, write: if isOwnerOrShared(get(/databases/$(database)/documents/contacts/$(contactId)).data);
      }
    }

    // 出租：擁有者、被分享的同事、或你都能讀寫
    match /rentals/{rentalId} {
      allow read: if request.auth != null && (
        request.auth.uid == "KiYlsnWcChW5muRkG167r7Mi1132" ||
        resource.data.ownerUid == request.auth.uid ||
        (request.auth.uid in resource.data.sharedWith)
      );
      allow update: if request.auth != null && request.resource.data.ownerUid == resource.data.ownerUid && (
        request.auth.uid == "KiYlsnWcChW5muRkG167r7Mi1132" ||
        resource.data.ownerUid == request.auth.uid ||
        ((request.auth.uid in resource.data.sharedWith) && request.resource.data.sharedWith == resource.data.sharedWith)
      );
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if request.auth != null && (resource.data.ownerUid == request.auth.uid || request.auth.uid == "KiYlsnWcChW5muRkG167r7Mi1132");
      match /{subcollection}/{docId} {
        allow read, write: if isOwnerOrShared(get(/databases/$(database)/documents/rentals/$(rentalId)).data);
      }
    }

    // 公司共用招租清單；原有 rentals 租約資料的權限保持獨立。
    match /companyRentals/{rentalId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid && validCompanyRental();
      allow update: if request.auth != null &&
        (resource.data.ownerUid == request.auth.uid || request.auth.uid == "KiYlsnWcChW5muRkG167r7Mi1132") &&
        request.resource.data.ownerUid == resource.data.ownerUid && validCompanyRental();
      // 使用暫停招租保留紀錄；一般同事不直接刪除案件。
      allow delete: if false;
      match /internal/{documentId} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null && documentId == 'details' &&
          (getAfter(/databases/$(database)/documents/companyRentals/$(rentalId)).data.ownerUid == request.auth.uid ||
           request.auth.uid == "KiYlsnWcChW5muRkG167r7Mi1132") &&
          request.resource.data.keys().hasOnly(['doorAddress', 'landlordName', 'landlordPhone', 'keyInfo', 'internalNotes', 'viewingInstructions', 'parkingNumber', 'motorbikeParkingNumber', 'sellerServiceFee', 'legacyServiceFee', 'updatedAt']);
      }
    }
    function validCompanyRental() {
      let d = request.resource.data;
      return d.keys().hasOnly(['title', 'community', 'type', 'area', 'city', 'district', 'street', 'floor', 'sizeBasis', 'mgmtMode', 'parking', 'parkMode', 'motorbikeParking', 'motorbikeParkMode', 'motorbikeParkFee', 'mandateExpiresOn', 'websiteExpiresOn', 'websiteExpirySource', 'websiteCheckStatus', 'websiteCheckedUrl', 'websiteCheckedAt', 'websiteUnavailable', 'minLease', 'moveIn', 'availableDate', 'pets', 'cook', 'subsidy', 'description', 'serviceFee', 'buyerServiceFee', 'viewingStatus', 'rooms', 'living', 'baths', 'size', 'rent', 'deposit', 'mgmt', 'parkFee', 'status', 'websiteUrl', 'albumUrl', 'shareWebsite', 'shareAlbum', 'furniture', 'equipmentCatalog', 'ownerUid', 'agentUid', 'agentName', 'agentPhone', 'branch', 'photos', 'revision', 'createdAt', 'updatedAt', 'lastModifiedByUid']) &&
        rentalDayField(d.get('mandateExpiresOn', '')) && rentalDayField(d.get('websiteExpiresOn', '')) &&
        d.get('websiteExpirySource', '') in ['', 'manual', '591'] &&
        d.get('websiteCheckStatus', 'unchecked') in ['unchecked', 'live', 'unlisted', 'unknown'] &&
        d.get('websiteCheckedUrl', '') is string && d.get('websiteCheckedUrl', '').size() <= 2000 &&
        d.get('websiteCheckedAt', 0) is number && d.get('websiteCheckedAt', 0) >= 0 &&
        d.get('websiteUnavailable', false) is bool &&
        d.get('motorbikeParking', '待確認') in ['待確認', '無機車位', '有機車位', '社區先到先停', '其他'] &&
        d.get('motorbikeParkMode', '待確認') in ['待確認', '已含租金', '另計'] &&
        (d.get('motorbikeParkFee', null) == null || (d.motorbikeParkFee is number && d.motorbikeParkFee >= 0 && d.motorbikeParkFee <= 100000000)) &&
        d.get('equipmentCatalog', []) is list && d.get('equipmentCatalog', []).size() <= 200 &&
        d.title is string && d.title.size() > 0 && d.title.size() <= 120 &&
        d.ownerUid is string && d.photos is list && d.photos.size() <= 10 &&
        d.status in ['available', 'rented', 'paused', 'draft'] &&
        d.lastModifiedByUid == request.auth.uid &&
        (d.status == 'draft' || (d.rent is number && d.rent > 0 && d.city.size() > 0 && d.district.size() > 0 && d.street.size() > 0));
    }
    function rentalDayField(value) {
      return value is string && (value == '' || value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
    }

    // 商談事項：擁有者、被分享的同事、或你都能讀寫
    match /topics/{topicId} {
      allow read: if request.auth != null && (
        request.auth.uid == "KiYlsnWcChW5muRkG167r7Mi1132" ||
        resource.data.ownerUid == request.auth.uid ||
        (request.auth.uid in resource.data.sharedWith)
      );
      allow update: if request.auth != null && request.resource.data.ownerUid == resource.data.ownerUid && (
        request.auth.uid == "KiYlsnWcChW5muRkG167r7Mi1132" ||
        resource.data.ownerUid == request.auth.uid ||
        ((request.auth.uid in resource.data.sharedWith) && request.resource.data.sharedWith == resource.data.sharedWith)
      );
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if request.auth != null && (resource.data.ownerUid == request.auth.uid || request.auth.uid == "KiYlsnWcChW5muRkG167r7Mi1132");
      match /{subcollection}/{docId} {
        allow read, write: if isOwnerOrShared(get(/databases/$(database)/documents/topics/$(topicId)).data);
      }
    }

    // 客需：擁有者、勾選「分享」之後任何登入帳號都能看，或你都能讀取
    // 編輯：擁有者（或你）能改全部欄位；被分享到的同事只能動「推薦物件」那塊，其他欄位（需求/預算等）不能碰
    match /needs/{needId} {
      allow read: if request.auth != null && (
        resource.data.ownerUid == request.auth.uid ||
        resource.data.shared == true ||
        request.auth.uid == "KiYlsnWcChW5muRkG167r7Mi1132"
      );
      allow update: if request.auth != null && (
        resource.data.ownerUid == request.auth.uid ||
        request.auth.uid == "KiYlsnWcChW5muRkG167r7Mi1132" ||
        (
          resource.data.shared == true &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["recommendedProperties", "lastModifiedByUid"])
        )
      );
      allow delete: if request.auth != null && (
        resource.data.ownerUid == request.auth.uid ||
        request.auth.uid == "KiYlsnWcChW5muRkG167r7Mi1132"
      );
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
    }

    // 判斷是不是資料的擁有者、被分享的同事、或主要負責人
    match /tenantNeeds/{needId} {
      allow read: if request.auth != null && (resource.data.ownerUid == request.auth.uid || request.auth.uid in resource.data.sharedWith || request.auth.uid == "KiYlsnWcChW5muRkG167r7Mi1132");
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid && request.resource.data.source == 'manual' && request.resource.data.sourceEventId == '' && validTenantNeed();
      allow update: if request.auth != null && request.resource.data.ownerUid == resource.data.ownerUid &&
        (resource.data.ownerUid == request.auth.uid || request.auth.uid == "KiYlsnWcChW5muRkG167r7Mi1132") &&
        request.resource.data.source == resource.data.source && request.resource.data.sourceEventId == resource.data.sourceEventId &&
        request.resource.data.createdAt == resource.data.createdAt && request.resource.data.revision == resource.data.revision + 1 && validTenantNeed();
      allow delete: if false;
    }
    function tenantText(d,k,max) { return d[k] is string && d[k].size() <= max; }
    function validTenantNeed() {
      let d = request.resource.data;
      return d.keys().hasOnly(['type','name','budgetText','includedFees','areas','communityStreet','roomText','minPingText','carParking','motorbikeParking','pets','subsidy','cook','equipment','moveIn','leaseTerm','requiredConditions','notes','status','sharedWith','budgetMin','budgetMax','budgetUnlimited','minPing','ownerUid','ownerName','source','sourceEventId','createdAt','updatedAt','revision','lastModifiedByUid']) &&
        tenantText(d,'includedFees',500) && tenantText(d,'communityStreet',500) && tenantText(d,'roomText',500) && tenantText(d,'minPingText',500) && tenantText(d,'carParking',500) && tenantText(d,'motorbikeParking',500) && tenantText(d,'pets',500) && tenantText(d,'subsidy',500) && tenantText(d,'cook',500) && tenantText(d,'equipment',500) && tenantText(d,'moveIn',500) && tenantText(d,'leaseTerm',500) && tenantText(d,'notes',2000) && tenantText(d,'requiredConditions',2000) &&
        d.type == '租屋' && d.name is string && d.name.size() > 0 && d.name.size() <= 500 && d.areas is string && d.areas.size() > 0 && d.areas.size() <= 500 &&
        d.budgetText is string && d.budgetText.size() > 0 && d.budgetText.size() <= 500 &&
        (d.budgetMax == null || (d.budgetMax is number && d.budgetMax > 0 && d.budgetMax <= 10000000)) &&
        (d.budgetMin == null || (d.budgetMin is number && d.budgetMin > 0 && d.budgetMin <= 10000000)) &&
        (d.budgetMax == null || d.budgetMin == null || d.budgetMin <= d.budgetMax) &&
        d.budgetUnlimited is bool && (d.budgetUnlimited || d.budgetMax != null || d.budgetMin != null) &&
        (d.minPing == null || (d.minPing is number && d.minPing >= 0)) &&
        d.status in ['searching','viewing','rented','paused'] && d.source in ['manual','line'] &&
        d.sharedWith is list && d.sharedWith.size() <= 50 && d.ownerUid is string && d.ownerName is string &&
        d.revision is number && d.revision >= 1 && d.lastModifiedByUid == request.auth.uid;
    }
    function isOwnerOrShared(data) {
      return request.auth != null && (
        request.auth.uid == "KiYlsnWcChW5muRkG167r7Mi1132" ||
        data.ownerUid == request.auth.uid ||
        (request.auth.uid in data.sharedWith)
      );
    }

    // 其他所有資料維持只有本人可以讀寫
    match /{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == "KiYlsnWcChW5muRkG167r7Mi1132";
    }
  }
}
