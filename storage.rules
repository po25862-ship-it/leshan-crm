rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // 物件資料表檔案開放給所有登入員工上傳/讀取
    match /properties/{propId}/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    // 其他檔案維持只有本人可以讀寫
    match /{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == "KiYlsnWcChW5muRkG167r7Mi1132";
    }
  }
}
