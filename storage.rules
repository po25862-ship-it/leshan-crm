rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // 案件附件：員工可讀與上傳受限檔案，刪除僅主要管理者
    match /properties/{propId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null &&
        request.resource.size <= 10 * 1024 * 1024 &&
        (
          request.resource.contentType.matches('image/(jpeg|png|webp|heic)') ||
          request.resource.contentType == 'application/pdf'
        );
      allow delete: if request.auth != null && request.auth.uid == "KiYlsnWcChW5muRkG167r7Mi1132";
    }
    // 公司租賃照片，每張最多 300KB。檔案路徑固定歸屬建案人。
    match /companyRentals/{ownerUid}/{rentalId}/{filename} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        (request.auth.uid == ownerUid || request.auth.uid == "KiYlsnWcChW5muRkG167r7Mi1132") &&
        request.resource.size > 0 && request.resource.size <= 300000 &&
        request.resource.contentType == 'image/jpeg';
      allow delete: if request.auth != null &&
        (request.auth.uid == ownerUid || request.auth.uid == "KiYlsnWcChW5muRkG167r7Mi1132");
    }
    // 私人開發信只允許本人存取，不建立公開下載網址。
    match /outreachPrivate/{uid}/{fileId} {
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid && fileId.matches('^[a-f0-9]{64}$') && request.resource.metadata.ownerUid == uid && request.resource.metadata.sha256 == fileId && request.resource.size > 0 && request.resource.size <= 5 * 1024 * 1024 && request.resource.contentType in ['application/pdf','image/jpeg','image/png'];
    }
    match /{topFolder}/{allPaths=**} {
      allow read, write: if topFolder != 'outreachPrivate' && request.auth != null && request.auth.uid == "KiYlsnWcChW5muRkG167r7Mi1132";
    }
  }
}
