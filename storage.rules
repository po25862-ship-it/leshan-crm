rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // 案件附件：員工可讀與上傳受限檔案，刪除僅主要管理者
    match /properties/{propId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null &&
        request.resource.size <= 10 * 1024 * 1024 &&
        (
          request.resource.contentType.matches('image/(jpeg|png|webp|heic)') ||
          request.resource.contentType == 'application/pdf'
        );
      allow delete: if request.auth != null && request.auth.uid == "KiYlsnWcChW5muRkG167r7Mi1132";
    }
    // 其他檔案維持只有本人可以讀寫
    match /{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == "KiYlsnWcChW5muRkG167r7Mi1132";
    }
  }
}
