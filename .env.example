# Vercel server-side environment variables. Never prefix these with REACT_APP_.
CRAWLER_WORKER_URL=https://your-private-crawler-worker.example.com
CRAWLER_INTERNAL_TOKEN=replace-with-the-same-long-random-token-as-the-worker

# Store the complete service-account JSON as one Vercel Secret value.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"leshan-crm","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...","client_email":"..."}
