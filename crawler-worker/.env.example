# 產生一段長隨機字串；CRM Vercel 與 worker 必須填相同值。
CRAWLER_INTERNAL_TOKEN=replace-with-a-long-random-token

# Worker 的暫存工作區。正式環境應掛載持久磁碟，便於除錯與重跑。
CRAWLER_WORK_ROOT=/data/leshan-market

# Google OAuth 僅放 worker 的部署 Secret，不要提交到 Git。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# 選填：允許無 Drive 憑證時只完成抓取，預設 false。
ALLOW_PIPELINE_WITHOUT_DRIVE=false
